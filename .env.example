# ===================================================================
# MINORA – Pure • Natural • Healthy
# Supabase Configuration Environment Variables
# ===================================================================

# Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous Key (safe to expose in client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# NOTE: Never place the Supabase service_role key in frontend environment variables.
